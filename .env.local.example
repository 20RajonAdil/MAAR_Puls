# Copy this file to .env.local and fill in real values.
# .env.local is already listed in .gitignore — never commit real keys.

# Required: server-only YouTube Data API v3 key.
# Get one at https://console.cloud.google.com/apis/credentials
# This key is read only inside lib/youtube/service.ts (server) and the
# /api/youtube/* routes — it is never sent to the browser.
YOUTUBE_API_KEY=

# Used for absolute URLs in metadata, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://maar-puls-vam1.vercel.app

# ---------------------------------------------------------------------------
# Cloud sync for subscriptions/history/saved (Postgres via Neon).
# Optional: without this, those lists still work but stay local to the
# device (localStorage only). See README "Cloud sync" section for setup.
# On Vercel, connecting a Postgres database from the Storage tab (Neon
# integration) injects DATABASE_URL automatically — you don't set it by
# hand there. For local dev, run `vercel env pull .env.local` after
# linking the project, or paste the connection string yourself.
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Google sign-in (NextAuth.js) — see README "Authentication" section for the
# full step-by-step Google Cloud Console setup.
# ---------------------------------------------------------------------------

# OAuth 2.0 Client ID + Secret from Google Cloud Console
# (APIs & Services -> Credentials -> Create Credentials -> OAuth client ID
# -> Application type: Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random secret NextAuth uses to sign/encrypt session tokens.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=

# The canonical URL of this app. Must match what you use to open the site.
# Local dev:
NEXTAUTH_URL=http://localhost:3000
# In production (e.g. on Vercel), set this to your real deployed URL,
# e.g. https://maar-puls-vam1.vercel.app
